<Window x:Class="ImpresosAlvarez.CorteDiario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImpresosAlvarez"
        mc:Ignorable="d"
                Title="Trabajos Entregados" Height="450" Width="900" WindowState="Maximized" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="8">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF000530" Offset="1"/>
                    <GradientStop Color="#FF000530"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="1" Style="{StaticResource LabelBoldBlack}" Content="Fecha"></Label>
        <DatePicker x:Name="dpFecha" Grid.Column="1" Grid.Row="1" SelectedDateChanged="dpFecha_SelectedDateChanged"></DatePicker>

        <Button x:Name="btnGenerarExcel" Grid.Column="5" Grid.Row="1" Content="Generar Excel" Click="btnExportarExcel_Click"></Button>
        <Button x:Name="btnGuardar" Grid.Column="6" Grid.Row="1" Content="Guardar" Click="btnGuardar_Click"></Button>
        <Button x:Name="btnCancelar" Grid.Column="7" Grid.Row="1" Content="Cancelar" Click="btnCancelar_Click"></Button>

        <GroupBox Header="Facturas" Grid.Row="2" Grid.ColumnSpan="8" Grid.RowSpan="5">
            <DataGrid x:Name="dgFacturas" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="8" Grid.RowSpan="4" AutoGenerateColumns="False" IsReadOnly="True" Margin="5" SelectionUnit="FullRow" MouseDoubleClick="dgFacturas_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding Path=numero}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Path=nombre}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Contribuyente" Binding="{Binding Path=NombreContribuyente}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="SubTotal" Binding="{Binding Path=subtotal}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding Path=total}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Referencia" Binding="{Binding Path=referencia}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Entrega" Binding="{Binding Path=entrego}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Observaciones" Binding="{Binding Path=observaciones}" Width="*"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Header="Cotizaciones" Grid.Row="7" Grid.ColumnSpan="8" Grid.RowSpan="5">
            <DataGrid x:Name="dgCotizaciones" Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="8" Grid.RowSpan="4" AutoGenerateColumns="False" IsReadOnly="True" Margin="5" SelectionUnit="FullRow" MouseDoubleClick="dgCotizaciones_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding Path=numero}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Path=NombreContribuyente}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding Path=total}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Referencia" Binding="{Binding Path=referencia}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Entrega" Binding="{Binding Path=entrego}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Observaciones" Binding="{Binding Path=observaciones}" Width="*"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Label x:Name="lblTotalFacturas" Grid.Column="0" Grid.Row="12" Grid.ColumnSpan="1" Style="{StaticResource LabelBoldBlack}" Content="Total Facturas"></Label>

        <Label x:Name="lblTotalCotizaciones" Grid.Column="4" Grid.Row="12" Grid.ColumnSpan="1" Style="{StaticResource LabelBoldBlack}" Content="Total Cotizaciones"></Label>

    </Grid>
</Window>
