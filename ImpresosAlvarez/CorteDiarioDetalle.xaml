<Window x:Class="ImpresosAlvarez.CorteDiarioDetalle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImpresosAlvarez"
        mc:Ignorable="d"
        Title="Corte Diario Detalle" Height="350" Width="300" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>            
        </Grid.RowDefinitions>        

        <Label Grid.Column="0" Grid.Row="0" Content="Entrega" FontWeight="Bold" Margin="5"/>
        <ComboBox x:Name="cbEntrega" Grid.Column="1" Grid.Row="0" Margin="5">
            
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="1" Content="Referencia" FontWeight="Bold" Margin="5"/>
        <ComboBox x:Name="cbReferencia" Grid.Column="1" Grid.Row="1" Margin="5">
            <ComboBoxItem Content="Firmo"/>
            <ComboBoxItem Content="Efectivo"/>
            <ComboBoxItem Content="Transferencia"/>
            <ComboBoxItem Content="Cheque"/>
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="2" Content="Observaciones" FontWeight="Bold" Margin="5"/>
        <TextBox x:Name="txtObservaciones" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Margin="5"/>

        <Button x:Name="btnGuardar" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Content="Guardar" Margin="5" Click="btnGuardar_Click"/>
        <Button x:Name="btnCancelar" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Content="Cancelar" Margin="5" Click="btnCancelar_Click"/>

    </Grid>
</Window>
