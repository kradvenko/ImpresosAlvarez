<Window x:Class="ImpresosAlvarez.ReporteVentasDirectas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImpresosAlvarez"
        mc:Ignorable="d"
                Title="Reporte de Ventas Directas" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel de Filtros -->
        <GroupBox Header="Filtros" Grid.Row="0" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Content="Fecha:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="dpFecha" SelectedDateFormat="Short" Width="120" VerticalAlignment="Center"/>
                <Button x:Name="btnFiltrar" Content="Filtrar" Width="80" Margin="10,0,0,0" Click="btnFiltrar_Click"/>
                <Button x:Name="btnLimpiar" Content="Limpiar" Width="80" Margin="10,0,0,0" Click="btnLimpiar_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Panel Principal con Splits -->
        <Grid Grid.Row="1" Margin="10,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- DataGrid de Ventas Directas -->
            <GroupBox Header="Ventas Directas" Grid.Row="0">
                <DataGrid x:Name="dgVentasDirectas" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="dgVentasDirectas_SelectionChanged"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding id_venta_directa}" Width="60"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding fecha}" Width="120"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding id_usuario}" Width="80"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding total, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding estado}" Width="80"/>
                        <DataGridTextColumn Header="Notas" Binding="{Binding notas}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Gray"/>

            <!-- DataGrid de Detalle Ventas Directas -->
            <GroupBox Header="Detalle Ventas Directas" Grid.Row="2">
                <DataGrid x:Name="dgDetalleVentas" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Detalle" Binding="{Binding id_detalle_venta_directa}" Width="80"/>
                        <DataGridTextColumn Header="ID Insumo" Binding="{Binding id_insumo}" Width="80"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding DescripcionInsumo}" Width="*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="80"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding precio, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Costo" Binding="{Binding costo, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Panel de Totales -->
        <GroupBox Header="Totales" Grid.Row="2" Margin="10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Total General:" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Label x:Name="lblTotalGeneral" Content="$0.00" FontWeight="Bold" FontSize="14" Foreground="Green" Width="100" HorizontalContentAlignment="Right"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
