<Window x:Class="ImpresosAlvarez.PendientesPorPagar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImpresosAlvarez"
        mc:Ignorable="d"
        Title="Pendientes Por Pagar" Height="450" Width="800" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <GroupBox Header="Facturas" Grid.Row="0" Grid.ColumnSpan="8" Grid.RowSpan="12">
            <DataGrid x:Name="dgFacturas" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="8" Grid.RowSpan="4" AutoGenerateColumns="False" IsReadOnly="True" Margin="5" SelectionUnit="FullRow" MouseDoubleClick="dgFacturas_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding estado}" Value="PAGADA">
                                <Setter Property="Background" Value="#FFB06518"></Setter>
                                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="FontSize" Value="14" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding estado}" Value="PAGO PARCIAL">
                                <Setter Property="Background" Value="#FF18B060"></Setter>
                                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="FontSize" Value="14" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding estado}" Value="SIN PAGO">
                                <Setter Property="Background" Value="#FF880334"></Setter>
                                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="FontSize" Value="14" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding Path=numero}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Path=nombre}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Pagado" Binding="{Binding Path=pagado}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding Path=total}" Width="*"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>        

        <Label x:Name="lblTotalFacturas" Grid.Column="0" Grid.Row="12" Grid.ColumnSpan="2" Style="{StaticResource LabelBold02}" Content="Total Facturas"></Label>
    </Grid>
</Window>
